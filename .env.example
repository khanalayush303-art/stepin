# ---------------------------------------------------------------------------
# StepIn — local development environment
#
# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Every value below is a local-development default and is safe to share.
# ---------------------------------------------------------------------------

# ----------------------------------------------------------------- Postgres
POSTGRES_DB=stepin
POSTGRES_USER=stepin
POSTGRES_PASSWORD=stepin
POSTGRES_PORT=5432

# ---------------------------------------------------------------------- API
# Host port the API is published on. The container always listens on 8080.
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# Origin allowed through CORS. Must match where the frontend is actually served.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------- Web
WEB_PORT=3000

# Used by the browser, so it must be reachable from the host — not "http://api".
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# ------------------------------------------------------------- Auth (Clerk)
# Create an application at https://dashboard.clerk.com, then copy these from
# Configure -> API Keys. Google sign-in is a social connection you enable
# inside that same Clerk dashboard — there is nothing to configure here for it.
#
# Public: safe in the browser bundle, matches Clerk's own naming convention.
# Unlike the rest of this file, this can't be left blank — @clerk/nextjs throws
# at startup without a *syntactically* valid key, even before any real sign-in
# happens. The placeholder below is not a real credential (it decodes to
# "example.clerk.accounts.dev$"); it only lets the app boot. Replace it with
# your real key to make sign-in/sign-up actually work.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
# Secret: server-side only (Next.js). Never commit a real value; never send to the browser.
# The placeholder below is also fake (all zeros) — same "lets it boot" role as above.
CLERK_SECRET_KEY=sk_test_0000000000000000000000000000000000000000
# Frontend API domain shown on the same page, e.g. https://your-app.clerk.accounts.dev.
# Used by the ASP.NET Core API for JWKS discovery only — it is not a secret.
CLERK_AUTHORITY=

# To promote a signed-up user to Admin (there is no UI for this by design):
#   psql "$DATABASE_URL" -c "UPDATE stepin.\"Users\" SET \"Role\" = 'Admin' WHERE \"ClerkUserId\" = 'user_xxx';"

# ---------------------------------------------------------------------------
# Running the API outside Docker against the Compose database:
#   ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=stepin;Username=stepin;Password=stepin
# ---------------------------------------------------------------------------
