# ---------------------------------------------------------------------------
# StepIn — local development environment
#
# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Every value below is a local-development default and is safe to share.
# ---------------------------------------------------------------------------

# ----------------------------------------------------------------- Postgres
POSTGRES_DB=stepin
POSTGRES_USER=stepin
POSTGRES_PASSWORD=stepin
POSTGRES_PORT=5432

# ---------------------------------------------------------------------- API
# Host port the API is published on. The container always listens on 8080.
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# Origin allowed through CORS. Must match where the frontend is actually served.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------- Web
WEB_PORT=3000

# Used by the browser, so it must be reachable from the host — not "http://api".
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# ------------------------------------------------------------- Auth (Phase 1)
# Real SMTP relay for verification/reset emails. Works unchanged against any
# provider's SMTP endpoint (SendGrid, Mailgun, SES, a corporate relay, ...) —
# switching providers is only ever a config change. Leave blank and the API
# still boots; sending an email will fail until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_FROM_ADDRESS=no-reply@stepin.local
SMTP_FROM_NAME=StepIn

# Google OAuth. Create a client at https://console.cloud.google.com/apis/credentials
# with an authorized redirect URI of <WEB_ORIGIN>/api/v1/auth/external/google/callback.
# The Google sign-in button returns 501 until both are set; nothing else breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, local development only: creates one seeded Admin account on boot.
# Never set these outside your own machine; never commit real values here.
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Running the API outside Docker against the Compose database:
#   ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=stepin;Username=stepin;Password=stepin
# ---------------------------------------------------------------------------
