<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>stepin-api-phase0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StepIn.Application\StepIn.Application.csproj" />
    <ProjectReference Include="..\StepIn.Infrastructure\StepIn.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Floating versions: pin these after your first successful restore. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <!-- Image decoding for upload validation — see AidxMediaValidation/AidxMediaEndpoints. MIT
         licensed (SkiaSharp, the .NET bindings for Google's Skia) — no commercial license
         requirement at any build configuration. SixLabors.ImageSharp was tried first: 4.x
         hard-fails a `-c Release` publish without a paid Six Labors license (this broke the real
         Docker image build, not a theoretical concern), and its unlicensed 3.1.x line carries open
         CVEs — accepting those as a trade-off was the wrong call, since a maintained,
         no-cost-licensed alternative exists. SKCodec additionally reads a file's declared
         dimensions before decoding its full pixel buffer, a stronger decompression-bomb mitigation
         than decode-then-measure. SkiaSharp.NativeAssets.Linux supplies the native libSkiaSharp.so
         the Linux container runtime needs (Windows/macOS ship inside the main package already). -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <!-- Required by the dotnet-ef tool when this project is used as the startup project; Infrastructure's own reference is PrivateAssets=all so it doesn't flow here transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StepIn.Api.Tests" />
  </ItemGroup>
</Project>
